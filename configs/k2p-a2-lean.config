#
# ============================================================================
# 斐讯 K2P A2 编译配置 (seed config)  ——  Lean LEDE 方案
# ----------------------------------------------------------------------------
# 说明：这是"种子配置"，云编译时会通过 `make defconfig` 自动补全全部依赖。
#       .config 中未被当前源码识别的 symbol 会被 defconfig 自动忽略，不会
#       导致编译失败；若某个插件因源码更新改了名称，可在 menuconfig 中补选。
#
# 硬件：MT7621AT + MT7615DN，128MB RAM，16MB 原厂 SPI Flash (未改)
# 限制：固件上限 15744 KiB (来自源码 IMAGE_SIZE := 15744k)
# 功能：ZeroTier(中文) / UPnP(中文) / 硬件加速 / BBR / Fullcone NAT
#
# ★ 体积是最大敌人：16MB 闪存塞下上述功能很紧张，本配置已按最小可用集裁剪。
# ★ 2025 年后 TurboACC 子项改名：真实项为 INCLUDE_OFFLOADING / INCLUDE_BBR_CCA，
#   旧的 INCLUDE_HW_FLOW / INCLUDE_FULLCONE_NAT 已失效，切勿再写。
# ============================================================================
#

# ----------------------------------------------------------------------------
# 1. 目标平台 (必须正确，否则刷机变砖)
# ----------------------------------------------------------------------------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ----------------------------------------------------------------------------
# 2. 镜像/文件系统 (squashfs 稳定、可恢复；不编译 initramfs 以省空间)
# ----------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_IMAGES_GZIP is not set
# 说明：不要手动改动 K2P 的分区大小，DTS 已固定 firmware=15744k。

# ----------------------------------------------------------------------------
# 3. LuCI 与中文语言 (Lean 源码默认中文，这里显式声明确保中文页)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_LANG_zh-cn is not set

# ----------------------------------------------------------------------------
# 4. ZeroTier + 中文管理页
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ----------------------------------------------------------------------------
# 5. UPnP + 中文管理页
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ----------------------------------------------------------------------------
# 6. TurboACC 网络加速 (LuCI → 网络 → TurboACC 中可图形化开关)
#    ★ 配置项名以当前源码为准：
#      INCLUDE_OFFLOADING = 硬件流卸载 (MT7621 flow offload)
#      INCLUDE_BBR_CCA    = TCP BBR 拥塞控制
#    SHORTCUT_FE 与 OFFLOADING 互斥(default y 仅 ipq 平台)，此处显式关闭省空间。
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
# 以下默认开启但本项目用不到，显式关闭以节省 Flash：
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_PDNSD is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSFORWARDER is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSPROXY is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM is not set

# ----------------------------------------------------------------------------
# 7. Fullcone NAT (NAT1)  ——  TurboACC 已无该子项，改用独立包
#    16MB 空间下保留 iptables 版 (通用、体积小)。
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_iptables-mod-fullconenat=y

# ----------------------------------------------------------------------------
# 8. 空间优化：关闭对本项目无用的大件
# ----------------------------------------------------------------------------
# 不编译 IPv6 全家桶 (如需要 IPv6，可自行开启 ipv6helper)
# CONFIG_PACKAGE_luci-app-ipv6helper is not set
# 主题用默认 bootstrap（兼容好、体积可控），不加额外主题
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-atmaterial is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# 关闭大体积的可选组件
# CONFIG_PACKAGE_libustream-mbedtls is not set

# ----------------------------------------------------------------------------
# 9. 系统基础 (保留默认，确保 LuCI/网络正常)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_netifd=y
