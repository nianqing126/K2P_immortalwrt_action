#
# ============================================================================
# 斐讯 K2P A2 编译配置 (seed config)  ——  Lean LEDE 方案
# ----------------------------------------------------------------------------
# 硬件：MT7621AT + MT7615DN，128MB RAM，16MB 原厂 SPI Flash (未改)
# 限制：固件上限 15744 KiB (IMAGE_SIZE := 15744k) —— 超过则 sysupgrade.bin 不生成
# 功能：ZeroTier(中文) / UPnP(中文) / 硬件加速 / BBR / Fullcone NAT
#
# ★★★ 极其重要 ★★★
# Lean 的 master 分支已升级到 24.10 + firewall4，default-settings 默认勾选了
# ssr-plus / xray / vlmcsd / vsftpd / ddns / 双主题 / IPv6 全家桶等大量插件，
# 若不明确关闭，rootfs 会膨胀到 22MB+ 直接超限、编译不出固件。
# 因此本配置采用「白名单 + 显式黑名单」：需要的开 =y，默认全家桶一律 =n。
# ============================================================================
#

# ----------------------------------------------------------------------------
# 1. 目标平台 (必须正确，否则刷机变砖)
# ----------------------------------------------------------------------------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ----------------------------------------------------------------------------
# 2. 镜像/文件系统
# ----------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_IMAGES_GZIP is not set

# ----------------------------------------------------------------------------
# 3. LuCI 与中文 (只用默认 bootstrap 单主题)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-design=n

# ----------------------------------------------------------------------------
# 4. ZeroTier + 中文管理页
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ----------------------------------------------------------------------------
# 5. UPnP + 中文管理页
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ----------------------------------------------------------------------------
# 6. 硬件加速 / BBR / Fullcone NAT
#    Lean 新版(24.10/firewall4)用官方 nftables 体系实现，不再依赖 TurboACC 网页插件：
#      - 硬件加速: kmod-nft-offload (MT7621 PPE)
#      - BBR:      kmod-tcp-bbr
#      - Fullcone: kmod-nft-fullcone + kmod-ipt-fullconenat
#    首次启动脚本会设置 firewall4 的 flow_offloading / fullcone 开关。
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-ipt-fullconenat=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y

# ----------------------------------------------------------------------------
# 7. ★ 显式关闭 default-settings 默认勾选的全家桶 (体积元凶) ★
#    这些是导致 rootfs 22MB 超限的直接原因，必须逐个 =n
# ----------------------------------------------------------------------------
# 7.1 科学上网套件 (ssr-plus + xray + 各类代理，最大头)
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_dns2tcp=n
CONFIG_PACKAGE_ipt2socks=n
CONFIG_PACKAGE_microsocks=n
CONFIG_PACKAGE_shadowsocksr-libev=n
CONFIG_PACKAGE_v2ray=n
# 7.2 其他预装 LuCI 应用
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_ddns-scripts_aliyun=n
CONFIG_PACKAGE_ddns-scripts_dnspod=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_nlbwmon=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-oui=n
CONFIG_PACKAGE_vlmcsd=n
CONFIG_PACKAGE_vsftpd=n
# 7.3 IPv6 —— 按用户要求全开
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables=y
# 7.4 其他可选大件
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_etherwake=n
CONFIG_PACKAGE_wget-ssl=n
CONFIG_PACKAGE_curl=n
CONFIG_PACKAGE_libcurl4=n
CONFIG_PACKAGE_openssl-util=n

# ----------------------------------------------------------------------------
# 8. 系统基础 (保留最小集，确保 LuCI/网络正常)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y
