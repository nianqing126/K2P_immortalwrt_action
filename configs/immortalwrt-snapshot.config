# ============================================================
# ImmortalWrt master (snapshot) —— Phicomm K2P (MT7621, mipsel_24kc)
# 基础功能保留官方默认（双频 WiFi、LuCI、防火墙、DHCP、PPPoE、SSH）
# 加装：ZeroTier 组网 + Turbo ACC 面板（软件流卸载 / BBR / nft-fullcone）+ UPnP
# 注意：snapshot 为每日主线构建，TurboACC 归档的 firewall4/nftables/libnftnl
# 版本可能低于主线而走降级回退，兼容性风险高于 24.10，长期稳定优先选 24.10。
# ============================================================

# ---------- 目标平台 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_phicomm_k2p=y

# ---------- LuCI 网页界面（保留，不做无网页精简版） ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-compat=y

# ---------- ZeroTier 组网（含网页管理页与中文） ----------
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
CONFIG_PACKAGE_kmod-tun=y

# ---------- Turbo ACC 面板（第三方 feed，CI 中由 add_turboacc.sh 注入源码与内核补丁） ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=y
# 不带 Shortcut-FE（第三方 sfe 作者未充分测试；软件流卸载已够用）
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV is not set

# 面板依赖的内核模块（由面板条件依赖自动拉入，此处显式固定）
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---------- UPnP（fw4/nftables 防火墙配套） ----------
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# 其余基础组件沿用 ImmortalWrt 默认选择，不在此主动关闭。
