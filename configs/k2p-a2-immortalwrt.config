#
# ============================================================================
# 斐讯 K2P A2 编译配置 —— ImmortalWrt 方案 (openwrt-25.12 / 内核 6.12)
# ----------------------------------------------------------------------------
# 说明：种子配置，云编译时通过 `make defconfig` 自动补全依赖。
#       未识别的 symbol 会被自动忽略；插件若因源码更新改名请在 menuconfig 补选。
#
# 硬件：MT7621AT + MT7615DN / 128MB RAM / 16MB 原厂闪存 (未改)
# 限制：固件上限 15744 KiB (ImmortalWrt 源码 IMAGE_SIZE := 15744k)
# 功能：ZeroTier(中文) / UPnP(中文) / 硬件加速 / BBR / Fullcone NAT
#
# ★ 新内核 (6.x) 与 LEDE 的差异：
#   - 防火墙用 firewall4 / nftables，fullcone 用官方 kmod-nft-fullcone
#   - 硬件加速用 kmod-nft-offload (MT7621 PPE 硬件流卸载)
#   - BBR 用 kmod-tcp-bbr
#   - 无线用开源 mt76 驱动 (kmod-mt7615-firmware)，无需闭源驱动
# ============================================================================
#

# ----------------------------------------------------------------------------
# 1. 目标平台
# ----------------------------------------------------------------------------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ----------------------------------------------------------------------------
# 2. 镜像/文件系统
# ----------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# 说明：不要手动改 K2P 分区大小，DTS 已固定 firmware=15744k。

# ----------------------------------------------------------------------------
# 3. LuCI 与中文语言
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh-cn=y

# ----------------------------------------------------------------------------
# 4. ZeroTier + 中文管理页
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ----------------------------------------------------------------------------
# 5. UPnP + 中文管理页
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ----------------------------------------------------------------------------
# 6. 硬件加速 (flow offload) —— firewall4 的 flow_offloading_hw
#    MT7621 从 mt7621 起主线内核开源支持 HFO/PPE 硬件 NAT
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y

# ----------------------------------------------------------------------------
# 7. Fullcone NAT (nftables 版) —— ImmortalWrt 官方提供
#    firewall4 已打 fullcone 补丁，UCI: firewall.@defaults[0].fullcone=1
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_fullconenat-nft=y

# ----------------------------------------------------------------------------
# 8. BBR 拥塞控制
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_tc-tiny=y

# ----------------------------------------------------------------------------
# 9. 空间优化 (16MB 紧张，关闭非必需大件)
# ----------------------------------------------------------------------------
# CONFIG_PACKAGE_luci-app-ipv6helper is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-atmaterial is not set

# ----------------------------------------------------------------------------
# 10. 系统基础
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_netifd=y
